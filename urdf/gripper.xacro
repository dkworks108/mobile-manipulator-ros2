<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- materials -->
  <material name="gripper_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="finger_silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <!-- gripper base mount on arm_link4 -->
  <joint name="gripper_joint" type="fixed">
    <parent link="arm_link4"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
      <material name="gripper_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.00026" ixy="0.0" ixz="0.0" iyy="0.00013" iyz="0.0" izz="0.00030"/>
    </inertial>
  </link>

  <!-- left finger -->
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="20.0" velocity="0.1"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
      <material name="finger_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000015" ixy="0.0" ixz="0.0" iyy="0.000015" iyz="0.0" izz="0.000002"/>
    </inertial>
  </link>

  <!-- right finger with mimic -->
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.02 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.03" upper="0.0" effort="20.0" velocity="0.1"/>
    <mimic joint="left_finger_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
      <material name="finger_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000015" ixy="0.0" ixz="0.0" iyy="0.000015" iyz="0.0" izz="0.000002"/>
    </inertial>
  </link>

</robot>
